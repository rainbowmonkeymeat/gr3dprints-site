# Don't put real keys in git. Copy this file to .dev.vars for local Wrangler.
# The deployed DOMAIN is in wrangler.toml. Do not put STRIPE_SECRET_KEY there.
# Set that name as a secret in the Pages dashboard.
# API keys: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=rk_test_...
